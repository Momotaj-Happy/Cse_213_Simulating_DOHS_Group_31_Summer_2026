<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>
<AnchorPane prefHeight="480.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.cse_213_simulating_dohs_group_31_summer_2026.SamiullahHridoy_2520900.Accountant.Controller.RecordPaymentController">
   <children>
      <Label layoutX="30.0" layoutY="14.0" text="Record Payment"><font><Font name="System Bold" size="18.0" /></font></Label>
      <Label layoutX="30.0" layoutY="70.0" text="Plot Number:" />
      <TextField fx:id="plotNumberField" layoutX="300.0" layoutY="66.0" prefWidth="200.0" />
      <Button layoutX="510.0" layoutY="65.0" onAction="#lookupButtonOnAction" prefWidth="60.0" text="Find" />

      <Label layoutX="30.0" layoutY="110.0" text="Unpaid Bill:" />
      <ComboBox fx:id="billComboBox" layoutX="300.0" layoutY="106.0" prefWidth="270.0" />

      <Label layoutX="30.0" layoutY="150.0" text="Payment Date:" />
      <DatePicker fx:id="paymentDatePicker" layoutX="300.0" layoutY="146.0" prefWidth="200.0" />
      <Label layoutX="30.0" layoutY="190.0" text="Amount Received:" />
      <TextField fx:id="amountField" layoutX="300.0" layoutY="186.0" prefWidth="200.0" />
      <Label layoutX="30.0" layoutY="230.0" text="Payment Method:" />
      <ComboBox fx:id="methodComboBox" layoutX="300.0" layoutY="226.0" prefWidth="200.0" />
      <Label layoutX="30.0" layoutY="270.0" text="Transaction Ref (if non-cash):" />
      <TextField fx:id="refNumberField" layoutX="300.0" layoutY="266.0" prefWidth="200.0" />

      <Button layoutX="300.0" layoutY="320.0" onAction="#recordButtonOnAction" prefWidth="200.0" text="Record Payment" />
      <Label fx:id="statusLabel" layoutX="30.0" layoutY="370.0" prefWidth="540.0" wrapText="true" />
      <Button layoutX="30.0" layoutY="430.0" onAction="#backButtonOnAction" prefWidth="100.0" text="Back" />
   </children>
</AnchorPane>
