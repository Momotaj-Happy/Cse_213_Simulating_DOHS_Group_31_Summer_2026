<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>
<AnchorPane prefHeight="500.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.cse_213_simulating_dohs_group_31_summer_2026.SamiullahHridoy_2520900.Accountant.Controller.ApplyConcessionController">
   <children>
      <Label layoutX="30.0" layoutY="14.0" text="Concessions &amp; Adjustments"><font><Font name="System Bold" size="18.0" /></font></Label>
      <Label layoutX="30.0" layoutY="70.0" text="Plot Number:" />
      <TextField fx:id="plotNumberField" layoutX="300.0" layoutY="66.0" prefWidth="200.0" />
      <Label layoutX="30.0" layoutY="110.0" text="Concession Type:" />
      <ComboBox fx:id="typeComboBox" layoutX="300.0" layoutY="106.0" prefWidth="200.0" />
      <Label layoutX="30.0" layoutY="150.0" text="Percent / Amount:" />
      <TextField fx:id="amountField" layoutX="300.0" layoutY="146.0" prefWidth="200.0" promptText="e.g. 20 (for 20%)" />
      <Label layoutX="30.0" layoutY="190.0" text="Start Date:" />
      <DatePicker fx:id="startDatePicker" layoutX="300.0" layoutY="186.0" prefWidth="200.0" />
      <Label layoutX="30.0" layoutY="230.0" text="End Date (optional):" />
      <DatePicker fx:id="endDatePicker" layoutX="300.0" layoutY="226.0" prefWidth="200.0" />
      <Label layoutX="30.0" layoutY="270.0" text="Approval Reference:" />
      <TextField fx:id="approvalRefField" layoutX="300.0" layoutY="266.0" prefWidth="200.0" />
      <Label layoutX="30.0" layoutY="310.0" text="Remarks / Justification:" />
      <TextArea fx:id="remarksArea" layoutX="30.0" layoutY="335.0" prefHeight="55.0" prefWidth="540.0" />

      <Button layoutX="300.0" layoutY="400.0" onAction="#applyButtonOnAction" prefWidth="200.0" text="Apply Concession" />
      <Label fx:id="statusLabel" layoutX="30.0" layoutY="445.0" prefWidth="540.0" wrapText="true" />
      <Button layoutX="30.0" layoutY="470.0" onAction="#backButtonOnAction" prefWidth="100.0" text="Back" />
   </children>
</AnchorPane>
