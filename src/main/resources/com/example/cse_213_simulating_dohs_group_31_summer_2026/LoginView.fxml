<?import javafx.scene.shape.SVGPath?>

<AnchorPane prefHeight="500.0" prefWidth="650.0" style="-fx-background-color: #F8FAFC;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.cse_213_simulating_dohs_group_31_summer_2026.LoginViewController">
    <children>
        <VBox alignment="CENTER" layoutX="125.0" layoutY="35.0" prefWidth="400.0" spacing="20.0" AnchorPane.bottomAnchor="35.0" AnchorPane.leftAnchor="125.0" AnchorPane.rightAnchor="125.0" AnchorPane.topAnchor="35.0">
            <children>
                <VBox alignment="CENTER" spacing="8.0">
                    <children>
                        <HBox alignment="CENTER" spacing="10.0">
                            <children>
                                <SVGPath content="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-5.45 9-12V5l-9-4z" fill="#2563EB" scaleX="1.2" scaleY="1.2" />
                                <Label style="-fx-font-family: 'Segoe UI'; -fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #0F172A;" text="DOHS Management System" />
                            </children>
                        </HBox>
                        <Label style="-fx-font-family: 'Segoe UI'; -fx-font-size: 13px; -fx-text-fill: #64748B;" text="Sign in to access your role dashboard" />
                    </children>
                </VBox>

                <VBox spacing="14.0" style="-fx-background-color: #FFFFFF; -fx-background-radius: 12px; -fx-border-color: #E2E8F0; -fx-border-radius: 12px; -fx-padding: 24px;">
                    <children>
                        <VBox spacing="4.0">
                            <children>
                                <Label style="-fx-font-family: 'Segoe UI'; -fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #334155;" text="User ID (Integer):" />
                                <TextField fx:id="staffIdTextField" prefHeight="38.0" promptText="Enter your User ID (e.g. 2520900)" style="-fx-background-color: #F8FAFC; -fx-background-radius: 8px; -fx-border-color: #CBD5E1; -fx-border-radius: 8px; -fx-padding: 8px 12px; -fx-font-family: 'Segoe UI';" />
                            </children>
                        </VBox>

                        <VBox spacing="4.0">
                            <children>
                                <Label style="-fx-font-family: 'Segoe UI'; -fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #334155;" text="Password:" />
                                <PasswordField fx:id="passwordField" prefHeight="38.0" promptText="Enter password" style="-fx-background-color: #F8FAFC; -fx-background-radius: 8px; -fx-border-color: #CBD5E1; -fx-border-radius: 8px; -fx-padding: 8px 12px; -fx-font-family: 'Segoe UI';" />
                            </children>
                        </VBox>

                        <VBox spacing="4.0">
                            <children>
                                <Label style="-fx-font-family: 'Segoe UI'; -fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #334155;" text="User Type / Role:" />
                                <ComboBox fx:id="userTypeComboBox" prefHeight="38.0" prefWidth="350.0" promptText="Select your role" style="-fx-background-color: #F8FAFC; -fx-background-radius: 8px; -fx-border-color: #CBD5E1; -fx-border-radius: 8px;" />
                            </children>
                        </VBox>

                        <Button onAction="#loginButtonOnAction" prefHeight="40.0" prefWidth="350.0" style="-fx-background-color: #2563EB; -fx-text-fill: white; -fx-font-family: 'Segoe UI'; -fx-font-size: 14px; -fx-font-weight: bold; -fx-background-radius: 8px; -fx-cursor: hand;" text="Sign In" />

                        <Label fx:id="statusLabel" alignment="CENTER" prefWidth="350.0" style="-fx-font-family: 'Segoe UI'; -fx-font-size: 12px; -fx-text-fill: #DC2626;" text="" />
