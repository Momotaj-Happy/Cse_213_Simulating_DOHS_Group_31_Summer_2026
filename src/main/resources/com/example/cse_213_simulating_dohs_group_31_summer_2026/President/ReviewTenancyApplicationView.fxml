<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>
<AnchorPane prefHeight="460.0" prefWidth="620.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.cse_213_simulating_dohs_group_31_summer_2026.SamiullahHridoy_2520900.President.Controller.ReviewTenancyApplicationController">
   <children>
      <Label layoutX="30.0" layoutY="14.0" text="Tenancy Applications"><font><Font name="System Bold" size="18.0" /></font></Label>
      <ListView fx:id="applicationsListView" layoutX="30.0" layoutY="55.0" prefHeight="180.0" prefWidth="560.0" />

      <Label layoutX="30.0" layoutY="250.0" text="Rejection reason (required if rejecting):" />
      <TextArea fx:id="rejectionReasonArea" layoutX="30.0" layoutY="275.0" prefHeight="60.0" prefWidth="560.0" />

      <Button layoutX="30.0" layoutY="350.0" onAction="#approveButtonOnAction" prefWidth="150.0" text="Approve" />
      <Button layoutX="200.0" layoutY="350.0" onAction="#rejectButtonOnAction" prefWidth="150.0" text="Reject" />

      <Label fx:id="statusLabel" layoutX="30.0" layoutY="390.0" prefWidth="560.0" wrapText="true" />
      <Button layoutX="30.0" layoutY="420.0" onAction="#backButtonOnAction" prefWidth="100.0" text="Back" />
   </children>
</AnchorPane>
