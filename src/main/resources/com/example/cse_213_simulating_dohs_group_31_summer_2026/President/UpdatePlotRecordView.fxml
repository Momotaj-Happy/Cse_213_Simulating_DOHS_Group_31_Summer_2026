<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>
<AnchorPane prefHeight="480.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.cse_213_simulating_dohs_group_31_summer_2026.SamiullahHridoy_2520900.President.Controller.UpdatePlotRecordController">
   <children>
      <Label layoutX="30.0" layoutY="14.0" text="Plot Registry — Edit Record"><font><Font name="System Bold" size="18.0" /></font></Label>
      <Label layoutX="30.0" layoutY="70.0" text="Plot Number to search:" />
      <TextField fx:id="searchField" layoutX="250.0" layoutY="66.0" prefWidth="180.0" />
      <Button layoutX="440.0" layoutY="65.0" onAction="#searchButtonOnAction" prefWidth="100.0" text="Search" />

      <Label layoutX="30.0" layoutY="120.0" text="Current record:" />
      <Label fx:id="currentRecordLabel" layoutX="30.0" layoutY="145.0" prefWidth="540.0" wrapText="true" />

      <Label layoutX="30.0" layoutY="190.0" text="New Area (kathas, optional):" />
      <TextField fx:id="newAreaField" layoutX="300.0" layoutY="186.0" prefWidth="200.0" />
      <Label layoutX="30.0" layoutY="225.0" text="New Road Number (optional):" />
      <TextField fx:id="newRoadField" layoutX="300.0" layoutY="221.0" prefWidth="200.0" />
      <Label layoutX="30.0" layoutY="260.0" text="New Plot Type (optional):" />
      <TextField fx:id="newTypeField" layoutX="300.0" layoutY="256.0" prefWidth="200.0" />
      <Label layoutX="30.0" layoutY="295.0" text="Remarks / reason for update:" />
      <TextArea fx:id="remarksArea" layoutX="30.0" layoutY="320.0" prefHeight="55.0" prefWidth="540.0" />

      <Button layoutX="300.0" layoutY="385.0" onAction="#updateButtonOnAction" prefWidth="200.0" text="Save Update" />
      <Label fx:id="statusLabel" layoutX="30.0" layoutY="420.0" prefWidth="540.0" wrapText="true" />
      <Button layoutX="30.0" layoutY="445.0" onAction="#backButtonOnAction" prefWidth="100.0" text="Back" />
   </children>
</AnchorPane>
