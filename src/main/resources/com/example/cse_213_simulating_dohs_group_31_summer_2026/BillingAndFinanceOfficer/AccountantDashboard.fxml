<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="480.0" prefWidth="620.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.cse_213_simulating_dohs_group_31_summer_2026.BillingAndFinanceOfficer.Controller.AccountantDashboardController">
   <children>
      <Label layoutX="30.0" layoutY="14.0" text="Billing &amp; Finance Dashboard">
         <font><Font name="System Bold" size="22.0" /></font>
      </Label>
      <Label fx:id="summaryLabel" layoutX="30.0" layoutY="50.0" prefWidth="560.0" text="Total bills: - | Unpaid: - | Overdue amount: -" />

      <Button layoutX="30.0" layoutY="95.0" prefWidth="260.0" onAction="#goGenerateMonthlyBills" text="Generate Monthly Bills" />
      <Button layoutX="310.0" layoutY="95.0" prefWidth="260.0" onAction="#goRecordPayment" text="Record Payment" />

      <Button layoutX="30.0" layoutY="140.0" prefWidth="260.0" onAction="#goArrearReport" text="Arrear Report" />
      <Button layoutX="310.0" layoutY="140.0" prefWidth="260.0" onAction="#goConcessions" text="Concessions &amp; Adjustments" />

      <Button layoutX="30.0" layoutY="185.0" prefWidth="260.0" onAction="#goTaxDemandNotices" text="Tax &amp; Ground Rent Notices" />
      <Button layoutX="310.0" layoutY="185.0" prefWidth="260.0" onAction="#goBillingHistory" text="Billing History" />

      <Button layoutX="30.0" layoutY="230.0" prefWidth="260.0" onAction="#goRefunds" text="Refunds &amp; Adjustments" />
      <Button layoutX="310.0" layoutY="230.0" prefWidth="260.0" onAction="#goFinancialSummary" text="Monthly Financial Summary" />

      <Button layoutX="30.0" layoutY="410.0" prefWidth="120.0" onAction="#signOutOnAction" text="Sign Out" />
   </children>
</AnchorPane>
