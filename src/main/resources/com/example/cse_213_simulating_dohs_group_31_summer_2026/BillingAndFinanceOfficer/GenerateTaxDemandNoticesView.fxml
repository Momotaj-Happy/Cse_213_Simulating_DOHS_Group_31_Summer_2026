<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>
<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.cse_213_simulating_dohs_group_31_summer_2026.BillingAndFinanceOfficer.Controller.GenerateTaxDemandNoticesController">
   <children>
      <Label layoutX="30.0" layoutY="14.0" text="Generate Tax Demand Notices"><font><Font name="System Bold" size="18.0" /></font></Label>
      <Label layoutX="30.0" layoutY="70.0" text="Financial Year:" />
      <TextField fx:id="financialYearField" layoutX="300.0" layoutY="66.0" prefWidth="200.0" promptText="e.g. 2025-2026" />

      <Button layoutX="300.0" layoutY="120.0" onAction="#generateButtonOnAction" prefWidth="200.0" text="Generate Notices" />
      <Label fx:id="statusLabel" layoutX="30.0" layoutY="170.0" prefWidth="540.0" wrapText="true" />
      <Button layoutX="30.0" layoutY="330.0" onAction="#backButtonOnAction" prefWidth="100.0" text="Back" />
   </children>
</AnchorPane>
