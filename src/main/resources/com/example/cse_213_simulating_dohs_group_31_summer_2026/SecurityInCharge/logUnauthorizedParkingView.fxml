                        <TableColumn fx:id="colLocation" prefWidth="130.0" text="Location" />
                        <TableColumn fx:id="colTime" prefWidth="80.0" text="Time" />
                        <TableColumn fx:id="colDate" prefWidth="95.0" text="Date" />
