<AnchorPane prefHeight="560.0" prefWidth="580.0" style="-fx-background-color: #F8FAFC;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.cse_213_simulating_dohs_group_31_summer_2026.SecurityInCharge.Controller.logUnauthorizedParkingController">
    <children>
        <VBox layoutX="24.0" layoutY="20.0" spacing="16.0" AnchorPane.leftAnchor="24.0" AnchorPane.rightAnchor="24.0" AnchorPane.topAnchor="20.0">
            <children>
                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <children>
                        <SVGPath content="M18.92 6.01C18.72 5.42 18.16 5 17.5 5h-11c-.66 0-1.21.42-1.42 1.01L3 12v8c0 .55.45 1 1 1h1c.55 0 1-.45 1-1v-1h12v1c0 .55.45 1 1 1h1c.55 0 1-.45 1-1v-8l-2.08-5.99z" fill="#4C6EF5" scaleX="1.2" scaleY="1.2" />
                        <Label style="-fx-font-family: 'Segoe UI'; -fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #1E293B;" text="Log Unauthorized Parking" />
                    </children>
                </HBox>

                <VBox spacing="12.0" style="-fx-background-color: #FFFFFF; -fx-background-radius: 12px; -fx-border-color: #E2E8F0; -fx-border-radius: 12px; -fx-padding: 16px;">
                    <children>
                        <GridPane hgap="12.0" vgap="10.0">
                            <children>
                                <Label style="-fx-font-family: 'Segoe UI'; -fx-font-size: 13px; -fx-text-fill: #475569;" text="License Plate:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                                <TextField fx:id="txtParkingPlate" prefHeight="34.0" promptText="DHAKA-MET-XXXX" style="-fx-background-color: #F1F5F9; -fx-background-radius: 6px; -fx-border-color: #CBD5E1; -fx-border-radius: 6px;" GridPane.columnIndex="1" GridPane.rowIndex="0" />

                                <Label style="-fx-font-family: 'Segoe UI'; -fx-font-size: 13px; -fx-text-fill: #475569;" text="Violation Location:" GridPane.columnIndex="2" GridPane.rowIndex="0" />
                                <TextField fx:id="txtParkingLocation" prefHeight="34.0" promptText="Enter location" style="-fx-background-color: #F1F5F9; -fx-background-radius: 6px; -fx-border-color: #CBD5E1; -fx-border-radius: 6px;" GridPane.columnIndex="3" GridPane.rowIndex="0" />

                                <Label style="-fx-font-family: 'Segoe UI'; -fx-font-size: 13px; -fx-text-fill: #475569;" text="Time (HH:MM):" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                                <TextField fx:id="txtParkingTime" prefHeight="34.0" promptText="12:00" style="-fx-background-color: #F1F5F9; -fx-background-radius: 6px; -fx-border-color: #CBD5E1; -fx-border-radius: 6px;" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                                <Label style="-fx-font-family: 'Segoe UI'; -fx-font-size: 13px; -fx-text-fill: #475569;" text="Date:" GridPane.columnIndex="2" GridPane.rowIndex="1" />
                                <DatePicker fx:id="dpParkingDate" prefHeight="34.0" prefWidth="170.0" style="-fx-background-color: #F1F5F9; -fx-background-radius: 6px;" GridPane.columnIndex="3" GridPane.rowIndex="1" />
                            </children>
                        </GridPane>

                        <HBox alignment="CENTER_RIGHT">
                            <children>
                                <Button onAction="#handleSaveParkingViolation" prefHeight="36.0" prefWidth="180.0" style="-fx-background-color: #4C6EF5; -fx-text-fill: white; -fx-font-family: 'Segoe UI'; -fx-font-weight: bold; -fx-background-radius: 6px; -fx-cursor: hand;" text="Save Parking Violation" />
                            </children>
                        </HBox>
                    </children>
