                <TableView fx:id="tblParkingViolations" prefHeight="220.0" prefWidth="532.0" style="-fx-background-color: #FFFFFF; -fx-background-radius: 10px; -fx-border-color: #E2E8F0; -fx-border-radius: 10px;">
