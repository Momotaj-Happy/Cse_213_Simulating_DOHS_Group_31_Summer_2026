<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>

<AnchorPane prefHeight="500.0" prefWidth="580.0" style="-fx-background-color: #F8FAFC;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.cse_213_simulating_dohs_group_31_summer_2026.SecurityInCharge.Controller.reviewActiveSilentAlarmsController">
    <children>
        <VBox layoutX="24.0" layoutY="20.0" spacing="16.0" AnchorPane.leftAnchor="24.0" AnchorPane.rightAnchor="24.0" AnchorPane.topAnchor="20.0">
            <children>
                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <children>
                        <SVGPath content="M12 22c1.1 0 2-.9 2-2h-4c0 1.1.89 2 2 2zm6-6v-5c0-3.07-1.64-5.64-4.5-6.32V4c0-.83-.67-1.5-1.5-1.5s-1.5.67-1.5 1.5v.68C7.63 5.36 6 7.92 6 11v5l-2 2v1h16v-1l-2-2z" fill="#4C6EF5" scaleX="1.2" scaleY="1.2" />
                        <Label style="-fx-font-family: 'Segoe UI'; -fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #1E293B;" text="Review Active Silent Alarms" />
                        <HBox HBox.hgrow="ALWAYS" />
                        <Button onAction="#handleFetchAlarms" prefHeight="36.0" prefWidth="160.0" style="-fx-background-color: #4C6EF5; -fx-text-fill: white; -fx-font-family: 'Segoe UI'; -fx-font-weight: bold; -fx-background-radius: 6px; -fx-cursor: hand;" text="Fetch Active Alarms" />
                    </children>
                </HBox>

                <TableView fx:id="tblActiveAlarms" prefHeight="260.0" prefWidth="532.0" style="-fx-background-color: #FFFFFF; -fx-background-radius: 10px; -fx-border-color: #E2E8F0; -fx-border-radius: 10px;">
                    <columns>
                        <TableColumn fx:id="colAlarmId" prefWidth="90.0" text="Alarm ID" />
                        <TableColumn fx:id="colAlarmLocation" prefWidth="140.0" text="Location" />
                        <TableColumn fx:id="colAlarmTime" prefWidth="90.0" text="Time" />
                        <TableColumn fx:id="colAlarmType" prefWidth="210.0" text="Type" />
                    </columns>
                </TableView>

                <HBox alignment="CENTER_LEFT" spacing="12.0" style="-fx-background-color: #FFFFFF; -fx-background-radius: 10px; -fx-border-color: #E2E8F0; -fx-border-radius: 10px; -fx-padding: 12px 16px;">
                    <children>
                        <Label style="-fx-font-family: 'Segoe UI'; -fx-font-size: 13px; -fx-text-fill: #475569;" text="Select Alarm:" />
                        <ComboBox fx:id="cmbSelectedAlarm" prefHeight="36.0" prefWidth="240.0" promptText="Select alarm to mute" style="-fx-background-color: #F1F5F9; -fx-background-radius: 6px;" />
                        <Button onAction="#handleMuteAlarm" prefHeight="36.0" prefWidth="130.0" style="-fx-background-color: #FA5252; -fx-text-fill: white; -fx-font-family: 'Segoe UI'; -fx-font-weight: bold; -fx-background-radius: 6px; -fx-cursor: hand;" text="Mute Alarm" />
                    </children>
                </HBox>

                <Label fx:id="lblAlarmDetails" style="-fx-font-family: 'Segoe UI'; -fx-font-size: 13px; -fx-text-fill: #059669; -fx-font-weight: bold;" text="" />
            </children>
        </VBox>
    </children>
</AnchorPane>
