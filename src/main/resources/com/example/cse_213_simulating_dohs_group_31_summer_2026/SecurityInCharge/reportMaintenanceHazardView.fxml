<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="580.0" prefWidth="560.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.cse_213_simulating_dohs_group_31_summer_2026.SecurityInCharge.Controller.reportMaintenanceHazardController">
    <children>
        <Label layoutX="30.0" layoutY="25.0" style="-fx-font-size: 18px; -fx-font-weight: bold;" text="Report Maintenance Hazard" AnchorPane.leftAnchor="30.0" AnchorPane.topAnchor="25.0" />
        <Label layoutX="30.0" layoutY="70.0" text="Hazard Name:" AnchorPane.leftAnchor="30.0" AnchorPane.topAnchor="70.0" />
        <TextField fx:id="txtHazardName" layoutX="150.0" layoutY="65.0" prefHeight="25.0" prefWidth="180.0" promptText="Enter hazard name" AnchorPane.leftAnchor="150.0" AnchorPane.topAnchor="65.0" />
        <Label layoutX="30.0" layoutY="115.0" text="Date:" AnchorPane.leftAnchor="30.0" AnchorPane.topAnchor="115.0" />
        <DatePicker fx:id="dpHazardDate" layoutX="150.0" layoutY="110.0" prefHeight="25.0" prefWidth="180.0" promptText="Select date" AnchorPane.leftAnchor="150.0" AnchorPane.topAnchor="110.0" />
        <Label layoutX="30.0" layoutY="160.0" text="Location:" AnchorPane.leftAnchor="30.0" AnchorPane.topAnchor="160.0" />
        <TextField fx:id="txtHazardLocation" layoutX="150.0" layoutY="155.0" prefHeight="25.0" prefWidth="180.0" promptText="Enter location" AnchorPane.leftAnchor="150.0" AnchorPane.topAnchor="155.0" />
        <Label layoutX="30.0" layoutY="205.0" text="Description:" AnchorPane.leftAnchor="30.0" AnchorPane.topAnchor="205.0" />
        <TextArea fx:id="txtHazardDescription" layoutX="150.0" layoutY="200.0" prefHeight="45.0" prefWidth="370.0" promptText="Enter description" AnchorPane.leftAnchor="150.0" AnchorPane.topAnchor="200.0" />
        <Button layoutX="350.0" layoutY="155.0" onAction="#handleSubmitHazard" prefWidth="170.0" text="Submit Hazard Report" AnchorPane.leftAnchor="350.0" AnchorPane.topAnchor="155.0" />

        <TableView fx:id="tblHazardReports" layoutX="30.0" layoutY="260.0" prefHeight="240.0" prefWidth="500.0" AnchorPane.leftAnchor="30.0" AnchorPane.rightAnchor="30.0" AnchorPane.topAnchor="260.0">
            <columns>
                <TableColumn fx:id="colHazardId" prefWidth="80.0" text="Report ID" />
                <TableColumn fx:id="colHazardName" prefWidth="110.0" text="Hazard Name" />
                <TableColumn fx:id="colDate" prefWidth="90.0" text="Date" />
                <TableColumn fx:id="colLocation" prefWidth="100.0" text="Location" />
                <TableColumn fx:id="colDescription" prefWidth="120.0" text="Description" />
            </columns>
        </TableView>

        <Label fx:id="lblHazardStatus" layoutX="30.0" layoutY="520.0" text="" AnchorPane.leftAnchor="30.0" AnchorPane.topAnchor="520.0" />
    </children>
</AnchorPane>
