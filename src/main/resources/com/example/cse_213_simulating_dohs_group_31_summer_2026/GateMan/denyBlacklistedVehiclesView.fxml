<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="450.0" prefWidth="500.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.cse_213_simulating_dohs_group_31_summer_2026.GateMan.Controller.denyBlacklistedVehiclesController">
    <children>
        <Label layoutX="30.0" layoutY="25.0" style="-fx-font-size: 18px; -fx-font-weight: bold;" text="Deny Blacklisted Vehicles" AnchorPane.leftAnchor="30.0" AnchorPane.topAnchor="25.0" />
        <Label layoutX="30.0" layoutY="70.0" text="Approaching Plate:" AnchorPane.leftAnchor="30.0" AnchorPane.topAnchor="70.0" />
        <TextField fx:id="txtApproachingPlate" layoutX="160.0" layoutY="65.0" prefHeight="25.0" prefWidth="160.0" promptText="Enter license plate" AnchorPane.leftAnchor="160.0" AnchorPane.topAnchor="65.0" />
        <Button layoutX="335.0" layoutY="65.0" onAction="#handleCheckBlacklist" prefWidth="135.0" text="Check Blacklist" AnchorPane.leftAnchor="335.0" AnchorPane.topAnchor="65.0" />
        
        <TableView fx:id="tblBlacklistedVehicles" layoutX="30.0" layoutY="110.0" prefHeight="260.0" prefWidth="440.0" AnchorPane.leftAnchor="30.0" AnchorPane.rightAnchor="30.0" AnchorPane.topAnchor="110.0">
            <columns>
                <TableColumn fx:id="colLicensePlate" prefWidth="180.0" text="License Plate" />
                <TableColumn fx:id="colReason" prefWidth="255.0" text="Reason For Blacklist" />
            </columns>
        </TableView>

        <Label fx:id="lblBlacklistAlert" layoutX="30.0" layoutY="390.0" text="" AnchorPane.leftAnchor="30.0" AnchorPane.topAnchor="390.0" />
    </children>
</AnchorPane>
