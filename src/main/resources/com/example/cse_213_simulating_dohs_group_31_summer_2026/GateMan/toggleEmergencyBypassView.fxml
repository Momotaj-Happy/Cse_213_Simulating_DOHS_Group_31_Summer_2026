<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>

<AnchorPane prefHeight="320.0" prefWidth="520.0" style="-fx-background-color: #F8FAFC;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.cse_213_simulating_dohs_group_31_summer_2026.GateMan.Controller.toggleEmergencyBypassController">
    <children>
        <VBox layoutX="24.0" layoutY="20.0" spacing="16.0" AnchorPane.leftAnchor="24.0" AnchorPane.rightAnchor="24.0" AnchorPane.topAnchor="20.0">
            <children>
                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <children>
                        <SVGPath content="M12 2L1 21h22L12 2zm1 14h-2v-2h2v2zm0-4h-2V10h2v2z" fill="#FA5252" scaleX="1.2" scaleY="1.2" />
                        <Label style="-fx-font-family: 'Segoe UI'; -fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #1E293B;" text="Toggle Emergency Gate Bypass" />
                    </children>
                </HBox>

                <VBox spacing="16.0" style="-fx-background-color: #FFFFFF; -fx-background-radius: 12px; -fx-border-color: #E2E8F0; -fx-border-radius: 12px; -fx-padding: 20px;">
                    <children>
                        <CheckBox fx:id="chkEmergencyOverride" style="-fx-font-family: 'Segoe UI'; -fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #1E293B;" text="Enable Gate Emergency Bypass Mode" />

                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                            <children>
                                <Button onAction="#handleProcessGateStatus" prefHeight="36.0" prefWidth="200.0" style="-fx-background-color: #20C997; -fx-text-fill: white; -fx-font-family: 'Segoe UI'; -fx-font-weight: bold; -fx-background-radius: 6px; -fx-cursor: hand;" text="Process Gate Status" />
                            </children>
                        </HBox>
                    </children>
                </VBox>

                <Label fx:id="lblEmergencyModeStatus" style="-fx-font-family: 'Segoe UI'; -fx-font-size: 13px; -fx-text-fill: #059669; -fx-font-weight: bold;" text="" />
            </children>
        </VBox>
    </children>
</AnchorPane>
