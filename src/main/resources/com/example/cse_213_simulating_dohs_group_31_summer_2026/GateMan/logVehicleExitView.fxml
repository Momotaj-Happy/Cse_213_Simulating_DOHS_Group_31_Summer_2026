            <children>
                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <children>
                        <SVGPath content="M18.92 6.01C18.72 5.42 18.16 5 17.5 5h-11c-.66 0-1.21.42-1.42 1.01L3 12v8c0 .55.45 1 1 1h1c.55 0 1-.45 1-1v-1h12v1c0 .55.45 1 1 1h1c.55 0 1-.45 1-1v-8l-2.08-5.99z" fill="#20C997" scaleX="1.2" scaleY="1.2" />
                        <Label style="-fx-font-family: 'Segoe UI'; -fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #1E293B;" text="Log Vehicle Exit" />
                    </children>
                </HBox>

                <HBox alignment="CENTER_LEFT" spacing="12.0" style="-fx-background-color: #FFFFFF; -fx-background-radius: 10px; -fx-border-color: #E2E8F0; -fx-border-radius: 10px; -fx-padding: 12px 16px;">
                    <children>
                        <TextField fx:id="txtExitingVehiclePlate" prefHeight="36.0" prefWidth="310.0" promptText="Enter exiting vehicle plate..." style="-fx-background-color: #F1F5F9; -fx-background-radius: 6px; -fx-border-color: #CBD5E1; -fx-border-radius: 6px; -fx-padding: 6px 12px; -fx-font-family: 'Segoe UI';" />
                        <Button fx:id="btnLogVehicleExit" onAction="#handleLogVehicleExit" prefHeight="36.0" prefWidth="160.0" style="-fx-background-color: #20C997; -fx-text-fill: white; -fx-font-family: 'Segoe UI'; -fx-font-weight: bold; -fx-background-radius: 6px; -fx-cursor: hand;" text="Log Vehicle Exit" />
                    </children>
                </HBox>

                <TableView fx:id="tblVehicleExitLogs" prefHeight="260.0" prefWidth="512.0" style="-fx-background-color: #FFFFFF; -fx-background-radius: 10px; -fx-border-color: #E2E8F0; -fx-border-radius: 10px;">
