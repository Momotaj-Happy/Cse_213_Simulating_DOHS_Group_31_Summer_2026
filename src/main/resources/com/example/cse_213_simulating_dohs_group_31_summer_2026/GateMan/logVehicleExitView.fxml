<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="450.0" prefWidth="520.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.cse_213_simulating_dohs_group_31_summer_2026.GateMan.Controller.logVehicleExitContrller">
    <children>
        <Label layoutX="30.0" layoutY="25.0" style="-fx-font-size: 18px; -fx-font-weight: bold;" text="Log Vehicle Exit" AnchorPane.leftAnchor="30.0" AnchorPane.topAnchor="25.0" />
        <Label layoutX="30.0" layoutY="70.0" text="Exiting Vehicle Plate:" AnchorPane.leftAnchor="30.0" AnchorPane.topAnchor="70.0" />
        <TextField fx:id="txtExitingVehiclePlate" layoutX="160.0" layoutY="65.0" prefHeight="25.0" prefWidth="160.0" promptText="Enter vehicle plate" AnchorPane.leftAnchor="160.0" AnchorPane.topAnchor="65.0" />
        <Button fx:id="btnLogVehicleExit" layoutX="335.0" layoutY="65.0" onAction="#handleLogVehicleExit" prefWidth="150.0" text="Log Vehicle Exit" AnchorPane.leftAnchor="335.0" AnchorPane.topAnchor="65.0" />

        <TableView fx:id="tblVehicleExitLogs" layoutX="30.0" layoutY="110.0" prefHeight="260.0" prefWidth="460.0" AnchorPane.leftAnchor="30.0" AnchorPane.rightAnchor="30.0" AnchorPane.topAnchor="110.0">
            <columns>
                <TableColumn fx:id="colVehicleNo" prefWidth="110.0" text="Vehicle No" />
                <TableColumn fx:id="colGuestName" prefWidth="110.0" text="Guest Name" />
                <TableColumn fx:id="colTimeIn" prefWidth="80.0" text="Time In" />
                <TableColumn fx:id="colTimeOut" prefWidth="80.0" text="Time Out" />
                <TableColumn fx:id="colStatus" prefWidth="75.0" text="Status" />
            </columns>
        </TableView>

        <Label fx:id="lblExitConfirmation" layoutX="30.0" layoutY="390.0" text="" AnchorPane.leftAnchor="30.0" AnchorPane.topAnchor="390.0" />
    </children>
</AnchorPane>
