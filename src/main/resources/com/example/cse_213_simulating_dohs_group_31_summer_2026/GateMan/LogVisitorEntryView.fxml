<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>

<AnchorPane prefHeight="600.0" prefWidth="600.0" style="-fx-background-color: #F8FAFC;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.cse_213_simulating_dohs_group_31_summer_2026.GateMan.Controller.logVisitorEntryController">
    <children>
        <VBox layoutX="24.0" layoutY="20.0" spacing="16.0" AnchorPane.leftAnchor="24.0" AnchorPane.rightAnchor="24.0" AnchorPane.topAnchor="20.0">
            <children>
                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <children>
                        <SVGPath content="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z" fill="#20C997" scaleX="1.2" scaleY="1.2" />
                        <Label style="-fx-font-family: 'Segoe UI'; -fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #1E293B;" text="Log Visitor Entry" />
                    </children>
                </HBox>

                <VBox spacing="12.0" style="-fx-background-color: #FFFFFF; -fx-background-radius: 12px; -fx-border-color: #E2E8F0; -fx-border-radius: 12px; -fx-padding: 16px;">
                    <children>
                        <GridPane hgap="12.0" vgap="10.0">
                            <children>
                                <Label style="-fx-font-family: 'Segoe UI'; -fx-font-size: 13px; -fx-text-fill: #475569;" text="Guest Name:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                                <TextField fx:id="txtGuestName" prefHeight="34.0" promptText="Enter guest name" style="-fx-background-color: #F1F5F9; -fx-background-radius: 6px; -fx-border-color: #CBD5E1; -fx-border-radius: 6px;" GridPane.columnIndex="1" GridPane.rowIndex="0" />

                                <Label style="-fx-font-family: 'Segoe UI'; -fx-font-size: 13px; -fx-text-fill: #475569;" text="Entry Time (HH:MM):" GridPane.columnIndex="2" GridPane.rowIndex="0" />
                                <TextField fx:id="txtEntryTime" prefHeight="34.0" promptText="08:30" style="-fx-background-color: #F1F5F9; -fx-background-radius: 6px; -fx-border-color: #CBD5E1; -fx-border-radius: 6px;" GridPane.columnIndex="3" GridPane.rowIndex="0" />

                                <Label style="-fx-font-family: 'Segoe UI'; -fx-font-size: 13px; -fx-text-fill: #475569;" text="Gate Number:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                                <ComboBox fx:id="cmbGateNo" prefHeight="34.0" prefWidth="180.0" promptText="Select Gate" style="-fx-background-color: #F1F5F9; -fx-background-radius: 6px;" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                                <Label style="-fx-font-family: 'Segoe UI'; -fx-font-size: 13px; -fx-text-fill: #475569;" text="Vehicle Number:" GridPane.columnIndex="2" GridPane.rowIndex="1" />
                                <TextField fx:id="txtVehicleNumber" prefHeight="34.0" promptText="DHAKA-MET-XXXX" style="-fx-background-color: #F1F5F9; -fx-background-radius: 6px; -fx-border-color: #CBD5E1; -fx-border-radius: 6px;" GridPane.columnIndex="3" GridPane.rowIndex="1" />
                            </children>
                        </GridPane>

                        <HBox alignment="CENTER_RIGHT">
                            <children>
                                <Button onAction="#handleLogVisitorEntry" prefHeight="36.0" prefWidth="170.0" style="-fx-background-color: #20C997; -fx-text-fill: white; -fx-font-family: 'Segoe UI'; -fx-font-weight: bold; -fx-background-radius: 6px; -fx-cursor: hand;" text="Log Entry" />
                            </children>
                        </HBox>
                    </children>
                </VBox>

                <TableView fx:id="tblVisitorEntries" prefHeight="230.0" prefWidth="552.0" style="-fx-background-color: #FFFFFF; -fx-background-radius: 10px; -fx-border-color: #E2E8F0; -fx-border-radius: 10px;">
                    <columns>
                        <TableColumn fx:id="colEntryId" prefWidth="80.0" text="Entry ID" />
                        <TableColumn fx:id="colGuestName" prefWidth="130.0" text="Guest Name" />
                        <TableColumn fx:id="colEntryTime" prefWidth="85.0" text="Time In" />
                        <TableColumn fx:id="colGateNo" prefWidth="65.0" text="Gate" />
                        <TableColumn fx:id="colVehicleNo" prefWidth="110.0" text="Vehicle No" />
                        <TableColumn fx:id="colStatus" prefWidth="80.0" text="Status" />
                    </columns>
                </TableView>

                <Label fx:id="lblLogVisitorStatus" style="-fx-font-family: 'Segoe UI'; -fx-font-size: 13px; -fx-text-fill: #059669; -fx-font-weight: bold;" text="" />
            </children>
        </VBox>
    </children>
</AnchorPane>
