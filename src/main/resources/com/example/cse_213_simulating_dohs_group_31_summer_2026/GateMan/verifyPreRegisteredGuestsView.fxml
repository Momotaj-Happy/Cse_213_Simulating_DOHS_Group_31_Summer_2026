<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="450.0" prefWidth="540.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.cse_213_simulating_dohs_group_31_summer_2026.GateMan.Controller.verifyPreRegisteredGuestsController">
    <children>
        <Label layoutX="30.0" layoutY="25.0" style="-fx-font-size: 18px; -fx-font-weight: bold;" text="Verify Pre-Registered Guests" AnchorPane.leftAnchor="30.0" AnchorPane.topAnchor="25.0" />
        <Label layoutX="30.0" layoutY="70.0" text="Guest License Plate:" AnchorPane.leftAnchor="30.0" AnchorPane.topAnchor="70.0" />
        <TextField fx:id="txtGuestLicensePlate" layoutX="160.0" layoutY="65.0" prefHeight="25.0" prefWidth="170.0" promptText="Enter guest license plate" AnchorPane.leftAnchor="160.0" AnchorPane.topAnchor="65.0" />
        <Button layoutX="345.0" layoutY="65.0" onAction="#handleVerifyPreRegistration" prefWidth="160.0" text="Verify Registration" AnchorPane.leftAnchor="345.0" AnchorPane.topAnchor="65.0" />

        <TableView fx:id="tblPreRegisteredGuests" layoutX="30.0" layoutY="110.0" prefHeight="260.0" prefWidth="480.0" AnchorPane.leftAnchor="30.0" AnchorPane.rightAnchor="30.0" AnchorPane.topAnchor="110.0">
            <columns>
                <TableColumn fx:id="colPreRegId" prefWidth="90.0" text="PreReg ID" />
                <TableColumn fx:id="colLicensePlate" prefWidth="130.0" text="License Plate" />
                <TableColumn fx:id="colHostName" prefWidth="140.0" text="Host Resident" />
                <TableColumn fx:id="colExpectedDate" prefWidth="115.0" text="Expected Date" />
            </columns>
        </TableView>

        <Label fx:id="lblVerificationMatchStatus" layoutX="30.0" layoutY="390.0" text="" AnchorPane.leftAnchor="30.0" AnchorPane.topAnchor="390.0" />
    </children>
</AnchorPane>
